#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLUSTER_NAME="devops-app-cluster"
CONTEXT="k3d-$CLUSTER_NAME"

for dependency in docker k3d kubectl; do
  if ! command -v "$dependency" >/dev/null 2>&1; then
    echo "Error: $dependency is not installed." >&2
    exit 1
  fi
done

if ! docker info >/dev/null 2>&1; then
  echo "Error: Docker daemon is unavailable. Start Docker and check your permissions." >&2
  exit 1
fi

clusters=$(k3d cluster list)
if ! awk -v name="$CLUSTER_NAME" '$1 == name { found = 1 } END { exit !found }' <<< "$clusters"; then
  k3d cluster create --config "$SCRIPT_DIR/k3d-config.yaml" --kubeconfig-switch-context=false
fi

bash "$SCRIPT_DIR/sync_local" "$CLUSTER_NAME"
kubectl --context "$CONTEXT" get services -n devops-app
cat <<EOF_HELP

Access the app with port-forwarding in separate terminals:
  kubectl --context $CONTEXT port-forward svc/dev-frontend -n devops-app 8501:22111
  kubectl --context $CONTEXT port-forward svc/dev-backend -n devops-app 8000:22112
Then open http://localhost:8501 or http://localhost:8000/health.

After editing the app, run: mise run k8s-sync-local
To delete the cluster: k3d cluster delete $CLUSTER_NAME
EOF_HELP
